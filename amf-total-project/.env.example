# 복사해서 .env 로 쓰되, .env 는 절대 커밋하지 않는다 (.gitignore 에 있음).
# 실제 배포 값은 Vercel 대시보드 > Settings > Environment Variables 에만 넣는다.
TURSO_DATABASE_URL=libsql://your-turso-db-url.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
EVENTS_WRITE_KEY=your-secure-write-key
GEMINI_API_KEY=your-google-gemini-api-key
# 프론트가 다른 도메인(github.io)에서 호출할 때만. 같은 Vercel 에서 서빙하면 비워 둔다.
ALLOWED_ORIGIN=
